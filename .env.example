# Variáveis do docker compose. Copie para .env e preencha PLATFORM_BASE_URL: cp .env.example .env

# Obrigatória só para o perfil "tunnel" (docker compose --profile tunnel up).
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Login do painel e segredo de assinatura do token.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
AUTH_SECRET=dev-only-secret-change-me

# Obrigatória: a Base URL informada na documentação do desafio.
PLATFORM_BASE_URL=

# Portas no host.
BACKEND_PORT=4000
FRONTEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
NGROK_INSPECT_PORT=4041
