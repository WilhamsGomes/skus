# Copie para .env. Valores de desenvolvimento local, alinhados ao docker-compose.yml.

# Porta HTTP do serviço (a documentação da plataforma usa `ngrok http 4000`).
PORT=4000

DATABASE_URL=postgresql://sku:sku@localhost:5432/sku_integration?schema=public
REDIS_URL=redis://localhost:6379

# Plataforma de integração (register, burst, enrich, callback).
PLATFORM_BASE_URL=https://dev-wdu-ped-test-1014944555984.us-central1.run.app

# Login único do dashboard (frontend) e segredo de assinatura do token.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
AUTH_SECRET=dev-only-secret-change-me
